{
  "manifest_version": 3,
  "name": "KBI Auto 出貨 (Shopee & iOPEN Mall)",
  "version": "1.10.0",
  "description": "Tombol Action & Print Resi di ERP KangenBukuIndo: otomatis 安排出貨 / 取寄件編號, salin nomor resi ke ERP, cetak label, dan cek pelunasan Shopee (款項已完成轉帳) & iOPEN Mall (對帳單 匯款成功) & FamilyMart (匯款成功) untuk Piutang Usaha.",
  "permissions": ["storage"],
  "host_permissions": ["https://seller.shopee.tw/*", "https://sales.iopenmall.tw/*", "https://epayment.7-11.com.tw/*", "https://fmec.famiport.com.tw/*", "https://www.fami.life/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://gen-lang-client-0501656267.web.app/*",
        "https://gen-lang-client-0501656267.firebaseapp.com/*"
      ],
      "js": ["erp-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://seller.shopee.tw/portal/sale/order*"],
      "js": ["shopee.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seller.shopee.tw/portal/sale/mass/ship*"],
      "js": ["shopee-print.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sales.iopenmall.tw/*/admweb/admweb.main.php*"],
      "js": ["iopen.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.fami.life/C2C/*"],
      "js": ["familymart.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://seller.shopee.tw/awbprint*",
        "https://epayment.7-11.com.tw/C2C/C2CWeb/MultiplePrintC2CPinCode.aspx*",
        "https://sales.iopenmall.tw/*/admweb/st711_c2c_od_print.php*"
      ],
      "js": ["print-page.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://seller.shopee.tw/portal/sale/mass/ship*", "https://sales.iopenmall.tw/*/admweb/admweb.main.php*"],
      "js": ["kbi-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
