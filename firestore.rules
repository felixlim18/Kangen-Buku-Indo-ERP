rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Identitas
    //
    // Akses hanya untuk akun yang:
    //   1. login ke Firebase Auth dengan email TERVERIFIKASI (akun Google selalu
    //      terverifikasi; akun email/password buatan sendiri tidak), dan
    //   2. terdaftar di /authorizedUsers/{email} (Manajemen User) dengan status
    //      bukan 'nonaktif'.
    // Role diambil dari authorizedUsers, BUKAN dari /users (yang bisa ditulis
    // pemiliknya sendiri) dan bukan dari daftar email/UID yang di-hardcode.
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function authPath() {
      return /databases/$(database)/documents/authorizedUsers/$(myEmail());
    }
    function member() {
      return signedIn()
        && exists(authPath())
        && get(authPath()).data.get('status', 'aktif') != 'nonaktif'
        && get(authPath()).data.get('role', '') in ['owner', 'staff'];
    }
    function isOwner() {
      return member() && get(authPath()).data.role == 'owner';
    }
    function hasPerm(key) {
      return isOwner()
        || (member() && get(authPath()).data.get('permissions', {}).get(key, false) == true);
    }

    // ------------------------------------------------------------------
    // Default: tolak semua. Koleksi yang tidak disebut di bawah tidak bisa diakses.
    // ------------------------------------------------------------------

    // Manajemen User: hanya owner yang menulis. Anggota boleh membaca dokumennya
    // sendiri (dipakai saat login); owner membaca semua.
    match /authorizedUsers/{email} {
      allow read: if isOwner() || (signedIn() && email == myEmail());
      allow write: if isOwner();
    }

    // Profil login. Pemilik boleh menulis profilnya, tapi field role harus sama
    // dengan role di authorizedUsers (tidak bisa mengangkat diri jadi owner).
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isOwner() || (
        member()
        && request.auth.uid == uid
        && request.resource.data.get('role', '') == get(authPath()).data.role
        && request.resource.data.get('email', '') == myEmail()
      );
      allow delete: if isOwner();
    }

    // Pengaturan. settings/line berisi token & secret LINE -> owner saja.
    match /settings/{id} {
      allow read: if id == 'line' ? isOwner() : member();
      allow write: if isOwner() || (id != 'line' && member());
    }

    // Gaji: data sensitif.
    match /payroll/{id} {
      allow read, write: if hasPerm('financial.payroll');
    }

    // Log audit & aktivitas user: hanya boleh ditambah, tidak bisa diubah/dihapus.
    match /auditLog/{id} {
      allow read: if member();
      allow create: if member();
    }
    match /userActivities/{id} {
      allow read: if member();
      allow create: if member();
    }

    // Preferensi per-user (mis. urutan tabel bulk packing). ID dokumen = email
    // (atau uid untuk akun tanpa email) pemiliknya.
    match /userPreferences/{prefId} {
      allow read, write: if member()
        && (prefId.lower() == myEmail() || prefId == request.auth.uid);
    }

    // Data LINE user id dari webhook (ditulis server).
    match /lineUsers/{id} {
      allow read, write: if isOwner();
    }

    // Data operasional ERP: semua anggota aktif boleh baca & tulis. Akses per-tab
    // diatur di UI (Manajemen User); di sini batasnya "anggota terdaftar & aktif".
    match /{collection}/{id} {
      allow read, write: if member() && collection in [
        'adsPurchases', 'accounts', 'amortizations', 'bankAccounts', 'bankReconciliations',
        'bebanLainnya', 'books', 'cashFlow', 'catalog', 'categories', 'channels',
        'closedPeriods', 'coa', 'coaAccounts', 'counters', 'damagedStock',
        'dashboardNotes', 'dashboardTasks', 'fixedAssets', 'freightIn', 'fxRates',
        'globalSettings', 'incomeEntries', 'inventory', 'inventoryLedger',
        'journalEntries', 'journals', 'loans', 'manualReceivables', 'ongkosKirim',
        'orderTypes', 'partners', 'paymentBatches', 'periodClosings',
        'perlengkapanCategories', 'perlengkapanItems', 'perlengkapanPurchases',
        'platforms', 'pricingTiers', 'prive', 'purchaseOrders', 'revaluasiKursLogs',
        'salesOrders', 'setoranModal', 'suppliers', 'usedDocCodes'
      ];
    }

    match /purchaseOrders/{poId}/receiptEvents/{eventId} {
      allow read, write: if member();
    }
    // collectionGroup('receiptEvents')
    match /{path=**}/receiptEvents/{eventId} {
      allow read: if member();
    }
  }
}
